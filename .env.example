# PayRoute Environment Variables Configuration

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=payroutedb
DB_USER=payroute
DB_PASSWORD=payroute_secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Ports
PORT=8080
FRONTEND_PORT=3000

# Spring Active Profile (local or docker)
SPRING_PROFILES_ACTIVE=docker
